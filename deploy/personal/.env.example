# Copy to .env on the SERVER. Never commit .env.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4-slim
# Starting budget, NOT a guarantee that Open WebUI fits. Measure on your server.
WEBUI_MEM_LIMIT=512m
# Total RAM + swap, not swap alone. Host swap must exist to use the extra 256 MiB.
WEBUI_MEMSWAP_LIMIT=768m
WEBUI_CPUS=1.0
WEBUI_BIND_IP=127.0.0.1
WEBUI_PORT=3000
WEBUI_URL=https://chat.example.com

# Run: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Required for unattended first startup in this deployment guide.
# Generate a separate password: openssl rand -hex 20
# After a successful first login, clear the following two values and recreate the container.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=Learner

# Optional: leave API key empty and configure the provider in Admin Settings > Connections.
# Include the API provider's documented API prefix (often /v1).
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
